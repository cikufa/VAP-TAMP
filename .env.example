# API Keys for VLM-TAMP
# Copy this file to .env and fill in your actual API keys

# OpenAI API Key (for GPT-4V)
OPENAI_API_KEY=your_openai_api_key_here
# Approved reproduction deviation; pin the snapshot to avoid alias drift.
VAPTAMP_OPENAI_MODEL=gpt-4o-2024-05-13

# Active free-tier Gemini backend
GEMINI_API_KEY=your_gemini_api_key_here
VAPTAMP_VLM_PROVIDER=gemini
VAPTAMP_GEMINI_MODEL=gemini-3.6-flash

# Anthropic API Key (for Claude 3)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
