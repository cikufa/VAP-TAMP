(define (domain connector_assembly)
    (:requirements :strips :typing :negative-preconditions)
    (:types agent connector socket - object)
    (:predicates
        (inview ?a - agent ?o - object)
        (available ?c - connector)
        (handempty ?a - agent)
        (holding ?a - agent ?c - connector)
        (held_left_configuration ?c - connector)
        (held_right_configuration ?c - connector)
        (side_clear_left ?s - socket)
        (side_clear_right ?s - socket)
        (inserted ?c - connector ?s - socket)
    )
    (:action grasp_connector_left
        :parameters (?a - agent ?c - connector)
        :precondition (and (available ?c) (handempty ?a) (inview ?a ?c))
        :effect (and (not (available ?c)) (not (handempty ?a))
                     (holding ?a ?c) (held_left_configuration ?c))
    )
    (:action grasp_connector_right
        :parameters (?a - agent ?c - connector)
        :precondition (and (available ?c) (handempty ?a) (inview ?a ?c))
        :effect (and (not (available ?c)) (not (handempty ?a))
                     (holding ?a ?c) (held_right_configuration ?c))
    )
    (:action insert_from_left_grasp
        :parameters (?a - agent ?c - connector ?s - socket)
        :precondition (and (holding ?a ?c) (held_left_configuration ?c)
                           (inview ?a ?s) (side_clear_left ?s))
        :effect (and (inserted ?c ?s))
    )
    (:action insert_from_right_grasp
        :parameters (?a - agent ?c - connector ?s - socket)
        :precondition (and (holding ?a ?c) (held_right_configuration ?c)
                           (inview ?a ?s) (side_clear_right ?s))
        :effect (and (inserted ?c ?s))
    )
    (:action return_connector
        :parameters (?a - agent ?c - connector ?s - socket)
        :precondition (and (holding ?a ?c))
        :effect (and (available ?c) (handempty ?a) (not (holding ?a ?c))
                     (not (held_left_configuration ?c)) (not (held_right_configuration ?c)) (not (inserted ?c ?s)))
    )
    (:action find
        :parameters (?a - agent ?o - object)
        :precondition (and (not (inview ?a ?o)))
        :effect (and (inview ?a ?o))
    )
)
